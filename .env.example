# Copy this file to a new file named ".env" and put your REAL values in ".env".
# NEVER put real keys in this file (.env.example is committed to GitHub).

# PLACEHOLDER 1: Replace with your Telegram BotFather token
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# PLACEHOLDER 2: Replace with your Google Gemini API key
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# PLACEHOLDER 3: Set to a currently available Gemini model
# Check https://ai.google.dev/gemini-api/docs/models and pick a low-cost "Flash" or
# "Flash-Lite" model name exactly as listed there (the "Endpoint"/model code).
GEMINI_MODEL=YOUR_AVAILABLE_GEMINI_MODEL

# ---- Optional settings (defaults shown) ----
# TIMEZONE=Asia/Karachi
# MAX_HISTORY_MESSAGES=12
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_TEMPERATURE=0.6
# GEMINI_MAX_OUTPUT_TOKENS=2048
# MAX_REGENERATION_RETRIES=2
# DATA_DIR=data
# LOG_LEVEL=INFO

# Optional cost estimate. Leave empty until you have checked Google's CURRENT pricing
# for your chosen model. Prices are per 1,000,000 tokens in the currency you name.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
# PRICE_CURRENCY=USD
